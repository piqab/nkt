# Проект собирается и разворачивается на Linux, а фикстуры изображают файлы
# Linux-хоста. Держим LF везде, независимо от того, на какой ОС идёт разработка.
* text=auto eol=lf

# Исключение из правила LF выше: батник Gradle запускается cmd.exe, которому
# нужны CRLF; с LF он на Windows ломается.
android/gradlew.bat text eol=crlf

# Бинарные и сгенерированные файлы git не трогает.
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
# jar/apk/keystore обязаны совпадать побайтно: под правилом eol=lf выше их
# спасала только эвристика определения бинарников, а испорченный
# gradle-wrapper.jar ломает сборку сообщением про GradleWrapperMain.
*.jar binary
*.apk binary
*.aar binary
*.keystore binary

# Собранный фронтенд вшивается в бинарник — в diff его показывать бессмысленно.
internal/webui/dist/** linguist-generated=true -diff
web/package-lock.json linguist-generated=true -diff
