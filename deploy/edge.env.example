# nkt-edge — входной сервис вебхуков выкладок хаба (см. site: nkt-edge).
# Файл: /etc/nkt-edge/edge.env, права 0600. Хаб ставит его сам («Выкладки»
# → nkt-edge → «Установить на хост»); этот пример — для ручной установки.

# Имя вебхуков (A-запись — на VPS). Сертификат на него выпускает certbot:
#   certbot certonly --standalone -d hooks.example.com --cert-name hooks.example.com \
#     --deploy-hook /etc/nkt-edge/certbot-deploy.sh
# (deploy/nkt-edge-certbot-hook.sh → /etc/nkt-edge/certbot-deploy.sh кладёт копию
# в /etc/nkt-edge/tls, откуда её читает служба).
EDGE_DOMAIN=hooks.example.com
# Общий секрет с хабом, не короче 32 знаков: openssl rand -base64 33
EDGE_TOKEN=
# Порт, к которому подключается хаб (туннель).
EDGE_TUNNEL_ADDR=:8444
# true — принимать вебхуки только с адресов GitHub (api.github.com/meta).
EDGE_GITHUB_ONLY=false
# Запросов в минуту с одного адреса.
EDGE_RATE=60
# 443 уже занят nginx/Caddy — edge за ними: вебхуки по HTTP только на
# loopback, сервер перенаправляет на него /hooks/ (см. site: nkt-edge).
# EDGE_PROXY_ADDR=127.0.0.1:8445
