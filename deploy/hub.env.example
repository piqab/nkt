# Конфигурация nkt hub. Скопируйте в /etc/netknownsthat/hub.env
# и установите права 0640 root:root — здесь может быть мастер-ключ
# шифрования и пароль администратора хаба.

NKT_MODE=hub

# Каталог данных: база хаба, кэш собранных бинарников, ключ шифрования
# секретов (если не задан NKT_HUB_MASTER_KEY ниже). Должен совпадать со
# StateDirectory в netknownsthat-hub.service.
NKT_DATA_DIR=/var/lib/netknownsthat-hub

# Путь к чекауту исходников этого репозитория НА ЭТОЙ ЖЕ машине — оттуда хаб
# кросс-компилирует nkt для каждого нового управляемого хоста и берёт
# deploy/netknownsthat.service для установки на него. Если хаб сам был
# установлен из готового бинарника с Releases (без git clone) и здесь
# исходников нет, хаб сам скачивает готовый бинарник и юнит с GitHub —
# версии, совпадающей с версией самого хаба. Нужен исходящий доступ к
# github.com; для форка репозитория задайте NKT_HUB_RELEASE_REPO.
NKT_HUB_SOURCE_ROOT=/opt/netknownsthat

# owner/repo на GitHub, откуда хаб скачивает готовый бинарник и systemd-юнит,
# когда исходников нет вообще (см. NKT_HUB_SOURCE_ROOT выше). Меняйте только
# на форке со своей страницей Releases.
NKT_HUB_RELEASE_REPO=piqab/nkt

# Бинарник go, которым хаб кросс-компилирует nkt под архитектуру каждого
# нового хоста. По умолчанию "go" ищется в PATH. Если по этому пути ничего
# нет или он не запускается (например, go — snap-пакет, а этот
# systemd-юнит блокирует его изоляцией), хаб сам скачает подходящий Go с
# go.dev в NKT_DATA_DIR/go-toolchain — вручную ничего ставить не нужно.
# Задайте абсолютный путь здесь, только если хотите закрепить конкретный
# уже установленный go вместо автоустановки.
NKT_HUB_GO_BIN=go

# Ключ шифрования SSH-секретов хостов и их учётных данных администратора:
# 32 случайных байта в base64 (`openssl rand -base64 32`). Оставьте пустым —
# хаб сгенерирует свой и сохранит в NKT_DATA_DIR/hub.key при первом старте.
NKT_HUB_MASTER_KEY=

# Как часто хаб в фоне опрашивает /api/overview каждого подключённого хоста
# для счётчиков находок и признака доступности — независимо от того, открыта
# ли веб-морда. Идёт через уже установленное SSH-соединение с хостом.
NKT_HUB_FINDINGS_POLL_INTERVAL=60s

# Как часто хаб в фоне проверяет GitHub Releases (NKT_HUB_RELEASE_REPO выше)
# на версию новее своей — только информационно (бейдж в разделе «О системе»),
# само обновление применяется только по явному нажатию кнопки там же.
NKT_HUB_UPDATE_CHECK_INTERVAL=6h

# Порт, который хаб сам открывает на каждом хосте с включённым резервным
# каналом (галочка в форме хоста) и на который сам же дозванивается, если
# у хоста откажет SSH — хаб и раньше умел ходить наружу к каждому хосту
# (тот же принцип, что и обычный SSH-дозвон), так что настраивать здесь
# адрес самого хаба не нужно вообще: адрес хоста уже известен. См. HUB.md,
# раздел 5.
NKT_HUB_TUNNEL_PORT=8078

# Веб-терминал для строки «localhost» в таблице хостов — той же машины,
# где уже работает сам хаб, поэтому (в отличие от терминала на управляемых
# хостах, где это отдельная галочка) включён по умолчанию для NKT_MODE=hub:
# оператор, способный запустить nkt hub, и так имеет shell на этой машине.
# Раскомментируйте, чтобы явно выключить.
# NKT_TERMINAL_ENABLED=false

NKT_SESSION_TTL=12h
NKT_BOOTSTRAP_ADMIN_USER=admin
# Если оставить пустым, при первом запуске будет сгенерирован пароль
# и один раз напечатан в журнал (journalctl -u netknownsthat-hub).
NKT_BOOTSTRAP_ADMIN_PASSWORD=
# По умолчанию true (кука сессии не уходит без HTTPS). Поставьте false, только
# если реально открываете хаб по голому HTTP (например, локальный доступ
# через SSH-туннель без TLS на reverse proxy).
NKT_COOKIE_SECURE=true

# По умолчанию слушает только localhost — как и обычный nkt, снаружи только
# через reverse proxy с TLS. Меняйте на 0.0.0.0:<порт> только если публикуете
# порт напрямую сами (например, из Docker) и TLS терминируете иначе.
NKT_ADDR=127.0.0.1:8077
NKT_CORS_ORIGINS=

# --- tls (опционально, вместо reverse proxy) -------------------------------------
# true — хаб сам слушает HTTPS вместо голого HTTP: генерирует и переиспользует
# самоподписанный сертификат в NKT_DATA_DIR/tls (браузер один раз покажет
# предупреждение, дальше запоминает). Свой сертификат — NKT_TLS_CERT/NKT_TLS_KEY.
NKT_TLS_ENABLED=false
# Какие имена/IP должен покрывать сгенерированный сертификат. По умолчанию —
# 127.0.0.1,::1,<hostname этой машины>; добавьте публичный IP/LAN-имя хаба,
# если открываете его напрямую, а не через SSH-туннель или localhost.
NKT_TLS_HOSTS=
NKT_TLS_CERT=
NKT_TLS_KEY=
