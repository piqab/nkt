# Конфигурация NetKnownsThat. Скопируйте в /etc/netknownsthat/nkt.env
# и установите права 0640 root:root — здесь может быть пароль администратора.

# --- источник данных -----------------------------------------------------------
# local    — читать настоящий хост (Linux); значение по умолчанию на Linux
# fixtures — читать снапшот из каталога примеров (для разработки, в т.ч. на Windows)
NKT_MODE=local

# --- где лежит состояние -------------------------------------------------------
# В режиме local это же значение подставляется по умолчанию, поэтому запущенный
# вручную `nkt tui` читает ту же базу, которую наполняет сервис.
NKT_DATA_DIR=/var/lib/netknownsthat

# --- что инспектировать --------------------------------------------------------
NKT_NGINX_ROOT=/etc/nginx
NKT_NGINX_MAIN_CONFIG=/etc/nginx/nginx.conf
NKT_HAPROXY_ROOT=/etc/haproxy
NKT_HAPROXY_MAIN_CONFIG=/etc/haproxy/haproxy.cfg
NKT_COMPOSE_FILES=/srv/docker/docker-compose.yml,/opt/stacks/docker-compose.yml
NKT_NGINX_ACCESS_LOGS=/var/log/nginx/access.log
NKT_HAPROXY_ACCESS_LOGS=/var/log/haproxy.log
NKT_DOCKER_SOCKET=/var/run/docker.sock

# --- как часто ------------------------------------------------------------------
# Голое число трактуется как секунды; допустимы и суффиксы Go: 30s, 5m, 12h.
NKT_PROBE_INTERVAL=60
NKT_PROBE_TIMEOUT=5s
NKT_METRICS_INTERVAL=60
NKT_LOG_SCAN_INTERVAL=300
NKT_INVENTORY_INTERVAL=300
NKT_RETENTION=720h
NKT_SCHEDULER_ENABLED=true

# --- безопасность ---------------------------------------------------------------
# Глобальный выключатель: false переводит приложение в режим только чтения.
NKT_ALLOW_MUTATIONS=true
NKT_COMMAND_TIMEOUT=30s

NKT_SESSION_TTL=12h
NKT_BOOTSTRAP_ADMIN_USER=admin
# Если оставить пустым, при первом запуске будет сгенерирован пароль
# и один раз напечатан в журнал (journalctl -u netknownsthat).
NKT_BOOTSTRAP_ADMIN_PASSWORD=
# true — если приложение отдаётся по HTTPS (через reverse proxy).
NKT_COOKIE_SECURE=false

# --- http -----------------------------------------------------------------------
# По умолчанию слушает только localhost. Наружу — только через reverse proxy с TLS.
NKT_ADDR=127.0.0.1:8077
NKT_CORS_ORIGINS=
