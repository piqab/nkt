# Конфигурация NetKnownsThat. Скопируйте в /etc/netknownsthat/nkt.env
# и установите права 0640 root:root — здесь может быть пароль администратора.

# --- источник данных -----------------------------------------------------------
# local    — читать настоящий хост (Linux); значение по умолчанию на Linux
# fixtures — читать снапшот из каталога примеров (для разработки, в т.ч. на Windows)
NKT_MODE=local

# --- где лежит состояние -------------------------------------------------------
# В режиме local это же значение подставляется по умолчанию, поэтому запущенный
# вручную `nkt tui` читает ту же базу, которую наполняет сервис.
NKT_DATA_DIR=/var/lib/netknownsthat

# --- что инспектировать --------------------------------------------------------
NKT_NGINX_ROOT=/etc/nginx
NKT_NGINX_MAIN_CONFIG=/etc/nginx/nginx.conf
NKT_HAPROXY_ROOT=/etc/haproxy
NKT_HAPROXY_MAIN_CONFIG=/etc/haproxy/haproxy.cfg
NKT_COMPOSE_FILES=/srv/docker/docker-compose.yml,/opt/stacks/docker-compose.yml
NKT_NGINX_ACCESS_LOGS=/var/log/nginx/access.log
NKT_HAPROXY_ACCESS_LOGS=/var/log/haproxy.log
NKT_DOCKER_SOCKET=/var/run/docker.sock

# --- как часто ------------------------------------------------------------------
# Голое число трактуется как секунды; допустимы и суффиксы Go: 30s, 5m, 12h.
NKT_PROBE_INTERVAL=60
NKT_PROBE_TIMEOUT=5s
NKT_METRICS_INTERVAL=60
NKT_LOG_SCAN_INTERVAL=300
NKT_INVENTORY_INTERVAL=300
NKT_RETENTION=720h
NKT_SCHEDULER_ENABLED=true

# --- безопасность ---------------------------------------------------------------
# Глобальный выключатель: false переводит приложение в режим только чтения.
NKT_ALLOW_MUTATIONS=true
NKT_COMMAND_TIMEOUT=30s
# certbot renew обращается к Let's Encrypt по сети и обычно занимает дольше,
# чем обычные быстрые команды хоста — свой, отдельный таймаут, чтобы NKT_COMMAND_TIMEOUT
# не убивал его на середине (видно как "код -1" и оборванный вывод).
NKT_CERTBOT_TIMEOUT=3m

# Веб-терминал (/api/terminal/ws) — полноценный интерактивный shell на этом
# хосте прямо в браузере, от имени пользователя, под которым запущен nkt
# (обычно root). Выключен по умолчанию: это прямой доступ к shell, а не
# ограниченное действие — включайте осознанно. Уже требует роль admin и
# NKT_ALLOW_MUTATIONS=true; этот флаг — третий, отдельный барьер поверх них.
NKT_TERMINAL_ENABLED=false
# Закрыть терминал, если ни ввода, ни вывода не было это время — забытая
# открытая вкладка не держит shell-процесс вечно.
NKT_TERMINAL_IDLE_TIMEOUT=30m

# --- автопродление сертификатов certbot ------------------------------------------
# По умолчанию выключено: приложение только показывает находки, продление —
# либо кнопкой «продлить» (вручную), либо через certbot.timer/cron на самом хосте.
# true — раз в NKT_AUTO_RENEW_INTERVAL сама запускает certbot renew для каждого
# certbot-сертификата не старше NKT_AUTO_RENEW_WITHIN до истечения (включая уже
# просроченные). Уважает NKT_ALLOW_MUTATIONS — при false задача не запускается.
NKT_AUTO_RENEW_CERTS=false
NKT_AUTO_RENEW_INTERVAL=6h
NKT_AUTO_RENEW_WITHIN=720h

NKT_SESSION_TTL=12h
NKT_BOOTSTRAP_ADMIN_USER=admin
# Если оставить пустым, при первом запуске будет сгенерирован пароль
# и один раз напечатан в журнал (journalctl -u netknownsthat).
NKT_BOOTSTRAP_ADMIN_PASSWORD=
# По умолчанию true (кука сессии не уходит без HTTPS). Поставьте false, только
# если реально открываете приложение по голому HTTP (например, локальный
# доступ через SSH-туннель без TLS на reverse proxy).
NKT_COOKIE_SECURE=true

# --- http -----------------------------------------------------------------------
# По умолчанию слушает только localhost. Наружу — только через reverse proxy с TLS.
NKT_ADDR=127.0.0.1:8077
NKT_CORS_ORIGINS=

# --- tls (опционально, вместо reverse proxy) -------------------------------------
# true — сам слушает HTTPS вместо голого HTTP: генерирует и переиспользует
# самоподписанный сертификат в NKT_DATA_DIR/tls (браузер один раз покажет
# предупреждение, дальше запоминает). Свой сертификат — задайте NKT_TLS_CERT/
# NKT_TLS_KEY вместо этого.
NKT_TLS_ENABLED=false
# Какие имена/IP должен покрывать сгенерированный сертификат. По умолчанию —
# 127.0.0.1,::1,<hostname этой машины>; добавьте сюда публичный IP/LAN-имя,
# если открываете напрямую, а не через SSH-туннель или localhost.
NKT_TLS_HOSTS=
NKT_TLS_CERT=
NKT_TLS_KEY=
