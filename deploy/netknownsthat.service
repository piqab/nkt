[Unit]
Description=NetKnownsThat — карта сетевых ресурсов и проверка конфигураций
Documentation=https://github.com/althq/netknownsthat
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/nkt
EnvironmentFile=/etc/netknownsthat/nkt.env
Restart=on-failure
RestartSec=5s

# Приложение читает /etc/nginx и /etc/haproxy, вызывает systemctl, iptables-save
# и ufw, поэтому работает от root. Ниже — ограничения, сужающие последствия
# компрометации процесса.
User=root
Group=root

StateDirectory=netknownsthat letsencrypt
StateDirectoryMode=0750
# certbot itself writes to /etc/letsencrypt, /var/lib/letsencrypt and
# /var/log/letsencrypt (its own hardcoded defaults — nkt passes it no
# --config-dir/--work-dir/--logs-dir) — but it runs as a plain child
# process of nkt, so it inherits this unit's own mount namespace. On a
# host where nothing has ever run certbot before, none of those three
# directories exist yet: plain ReadWritePaths can only make an EXISTING
# path writable, so listing a not-yet-existing one there is a no-op, and
# certbot's very first write (its own lock file) fails with "Read-only
# file system" — the ExecStart process can't mkdir its way out of that
# either, since /etc and /var/log are themselves read-only under
# ProtectSystem=strict. StateDirectory=/LogsDirectory=/
# ConfigurationDirectory= are the systemd-native fix: unlike raw
# ReadWritePaths, they CREATE the named directory (root:root) before the
# sandboxed process ever starts, so there is no first-run gap.
ConfigurationDirectory=letsencrypt
LogsDirectory=letsencrypt
WorkingDirectory=/var/lib/netknownsthat

# Файловая система только на чтение, кроме явно перечисленных каталогов.
# nginx, haproxy и caddy — любой из них может отсутствовать на конкретном
# хосте (например, установлен только один из трёх, или ни одного); "-"
# делает путь необязательным для systemd, иначе отсутствие каталога валит
# весь сервис на шаге NAMESPACE ("No such file or directory") ещё до
# запуска самого nkt, который сам по себе прекрасно работает без части
# из них.
# /etc/letsencrypt отдельно перечислен в ReadWritePaths, хотя и создаётся
# через ConfigurationDirectory выше: этой директиве systemd монтирует его
# read-only по умолчанию (в отличие от StateDirectory/LogsDirectory) —
# сделано так специально, чтобы обычный сервис не мог сам менять свой
# конфиг, но certbot должен писать именно туда (это его хранилище
# сертификатов, не конфиг nkt), поэтому явно переопределяется на запись.
ProtectSystem=strict
ReadWritePaths=/var/lib/netknownsthat
ReadWritePaths=-/etc/nginx
ReadWritePaths=-/etc/haproxy
ReadWritePaths=-/etc/caddy
ReadWritePaths=-/etc/letsencrypt
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

# Управление сервисами и firewall требует этих возможностей; всё остальное
# снято. CAP_SYS_PTRACE — отдельная история: без неё ядро отклоняет чтение
# /proc/<pid>/fd, /proc/<pid>/cmdline и /proc/<pid>/cgroup ЧУЖОГО процесса
# (ptrace_may_access()) даже для root под CapabilityBoundingSet — сам факт
# UID=0 тут не помогает, ограничение накладывается поверх него. Без этой
# capability `ss -p` видит атрибуцию процесса только для собственных
# сокетов nkt, а обогащение "Разного" (internal/parse/process.go: ps и
# чтение cgroup по чужим PID) не находит вообще ничего — оба симптома
# выглядят как «не работает», хотя код исправен, просто ядро молча
# отказывает в доступе.
#
# CAP_NET_BIND_SERVICE — та же история ещё раз, но для портов <1024: без
# неё root под CapabilityBoundingSet не может забиндиться на 80/443 —
# ядро отказывает точно так же молча. Нужна certbot'у: --standalone
# поднимает временный сервер на 80 (или 443) для HTTP-01/TLS-ALPN-01
# challenge — без этой capability он падает с ошибкой сразу после
# "Requesting a certificate for ...", хотя тот же certbot с теми же
# аргументами прекрасно отрабатывает вручную через sudo (там root не
# ограничен CapabilityBoundingSet вообще).
#
# CAP_SYS_ADMIN — запасной способ выйти из ProtectSystem=strict, когда
# основной (systemd-run --pty, см. internal/api/pty_session.go) не
# работает: на хосте без D-Bus (некоторые минимальные облачные образы,
# например Debian 11, не ставят его по умолчанию) systemd-run не может
# достучаться до PID 1 вообще. С этой capability nkt вместо него сам
# заходит в РЕАЛЬНОЕ (не песочное) mount-пространство имён PID 1 через
# `nsenter --target 1 --mount` — тем самым можно поставить сам dbus (см.
# кнопку рядом с терминалом) и вообще починить основной путь. Не даёт
# ничего практически нового по сравнению с уже имеющимся набором прав:
# процесс и так root с CAP_SYS_PTRACE и уже умеет полностью выходить из
# песочницы через systemd-run, когда D-Bus жив — это лишь альтернативный
# способ того же самого выхода на случай, когда основной недоступен.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Было RestrictNamespaces=yes (запрещает вход/создание НИКАКИХ пространств
# имён). Сужено до "mnt" — разрешает ровно то, что нужно nsenter'у выше
# (--mount, только это одно пространство имён), явно оставляя net/pid/
# uts/ipc/user запрещёнными: nsenter в этот процесс их и не трогает.
RestrictNamespaces=mnt
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# setns(2) сам по себе не входит в группу @system-service (она сознательно
# исключает @mount, куда его относит systemd) — RestrictNamespaces=mnt выше
# разрешает ЧЕМ можно пользоваться (тип пространства имён), но не отменяет
# то, что базовый SystemCallFilter вообще блокирует сам системный вызов.
# Без этой строки nsenter --target 1 --mount падает с "reassociate to
# namespaces failed: Operation not permitted" несмотря на CAP_SYS_ADMIN и
# правильный RestrictNamespaces — сам setns() отфильтровывается раньше,
# чем ядро успевает проверить capability. Добавлен только этот один вызов,
# не вся группа @mount: mount/umount2/pivot_root и т.п. nsenter --mount не
# использует и они по-прежнему запрещены.
SystemCallFilter=setns
SystemCallErrorNumber=EPERM

# Слушает только localhost по умолчанию (см. NKT_ADDR); наружу — через reverse
# proxy с TLS.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
