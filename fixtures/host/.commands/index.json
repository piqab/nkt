{
  "_comment": "Заготовленные ответы хоста для режима fixtures. match — префикс argv; побеждает самый длинный совпавший префикс.",
  "commands": [
    { "match": ["systemctl", "show", "nginx"], "stdout_file": "systemctl_show_nginx.txt" },
    { "match": ["systemctl", "show", "haproxy"], "stdout_file": "systemctl_show_haproxy.txt" },
    { "match": ["systemctl", "show", "docker"], "stdout_file": "systemctl_show_docker.txt" },
    { "match": ["systemctl", "show", "podman.socket"], "stdout_file": "systemctl_show_podman.txt" },
    { "match": ["systemctl", "show", "snap.lxd.daemon"], "stdout_file": "systemctl_show_lxd.txt" },
    { "match": ["systemctl", "show", "libvirtd"], "stdout_file": "systemctl_show_libvirtd.txt" },
    { "match": ["systemctl", "show", "ufw"], "stdout_file": "systemctl_show_ufw.txt" },
    { "match": ["systemctl", "show", "fail2ban"], "stdout_file": "systemctl_show_fail2ban.txt" },
    { "match": ["systemctl", "show"], "stdout": "Description=\nActiveState=inactive\nSubState=dead\nUnitFileState=not-found\nActiveEnterTimestamp=\nMainPID=0\nMemoryCurrent=0\nNRestarts=0\n" },

    { "_comment": "Таймер certbot намеренно выключен: сертификаты есть, а продлевать их некому.",
      "match": ["systemctl", "is-active", "certbot.timer"], "stdout": "inactive\n", "exit_code": 3 },
    { "match": ["systemctl", "is-active"], "stdout": "inactive\n", "exit_code": 3 },

    { "match": ["certbot", "renew", "--cert-name", "app.example.com"],
      "stdout": "Cert not yet due for renewal, forced renewal...\nCongratulations, all renewals succeeded:\n  /etc/letsencrypt/live/app.example.com/fullchain.pem (success)\n",
      "exit_code": 0, "simulated": true },
    { "_comment": "Эта lineage аутентифицируется через --standalone (см. renewal/standalone.example.com.conf) — на реальном хосте certbot сам слушает :80/:443, поэтому nginx/haproxy должны быть уже остановлены до этого вызова.",
      "match": ["certbot", "renew", "--cert-name", "standalone.example.com"],
      "stdout": "Congratulations, all renewals succeeded:\n  /etc/letsencrypt/live/standalone.example.com/fullchain.pem (success)\n",
      "exit_code": 0, "simulated": true },

    { "_comment": "Выпуск НОВОГО сертификата (StartIssueCertbot) для домена, которого certbot ещё не знает — не renew.",
      "match": ["certbot", "certonly", "--standalone", "--non-interactive", "--agree-tos", "--register-unsafely-without-email", "-d", "newsite.example.com"],
      "stdout": "Successfully received certificate.\nCertificate is saved at: /etc/letsencrypt/live/newsite.example.com/fullchain.pem\nKey is saved at:         /etc/letsencrypt/live/newsite.example.com/privkey.pem\n",
      "exit_code": 0, "simulated": true },


    { "match": ["nginx", "-t"], "stderr": "nginx: the configuration file /etc/nginx/nginx.conf syntax is ok\nnginx: configuration file /etc/nginx/nginx.conf test is successful\n", "exit_code": 0, "simulated": true },
    { "match": ["nginx", "-v"], "stderr": "nginx version: nginx/1.24.0 (Ubuntu)\n", "simulated": true },
    { "match": ["haproxy", "-c"], "stdout": "Configuration file is valid\n", "exit_code": 0, "simulated": true },
    { "match": ["haproxy", "-v"], "stdout": "HAProxy version 2.8.5-1ubuntu3 2026/01/24 - https://haproxy.org/\n", "simulated": true },

    { "match": ["iptables-save"], "stdout_file": "iptables_save.txt" },
    { "match": ["ip6tables-save"], "stdout_file": "ip6tables_save.txt" },
    { "match": ["ufw", "status", "numbered"], "stdout_file": "ufw_status_numbered.txt" },
    { "match": ["ufw", "status"], "stdout_file": "ufw_status.txt" },
    { "match": ["ufw", "allow"], "stdout": "Rule added\nRule added (v6)\n", "simulated": true },
    { "match": ["ufw", "deny"], "stdout": "Rule added\nRule added (v6)\n", "simulated": true },
    { "match": ["ufw", "delete"], "stdout": "Deleting:\nRule deleted\n", "simulated": true },
    { "match": ["ufw", "reload"], "stdout": "Firewall reloaded\n", "simulated": true },
    { "match": ["iptables"], "stdout": "", "simulated": true },

    { "match": ["lxc", "list", "--format", "json"], "stdout_file": "lxc_list.json" },
    { "match": ["lxc", "start"], "stdout": "", "exit_code": 0, "simulated": true },
    { "match": ["lxc", "stop"], "stdout": "", "exit_code": 0, "simulated": true },
    { "match": ["lxc", "restart"], "stdout": "", "exit_code": 0, "simulated": true },
    { "match": ["lxc", "pause"], "stdout": "", "exit_code": 0, "simulated": true },
    { "match": ["lxc", "launch"], "stdout": "Creating instance\nStarting instance\n", "exit_code": 0, "simulated": true },
    { "match": ["lxc", "delete"], "stdout": "", "exit_code": 0, "simulated": true },

    { "match": ["virsh", "-c", "qemu:///system", "list", "--all", "--name"], "stdout": "web-vm\ndb-vm\n" },
    { "match": ["virsh", "-c", "qemu:///system", "dominfo", "web-vm"], "stdout_file": "virsh_dominfo_web-vm.txt" },
    { "match": ["virsh", "-c", "qemu:///system", "dumpxml", "web-vm"], "stdout_file": "virsh_dumpxml_web-vm.txt" },
    { "match": ["virsh", "-c", "qemu:///system", "dominfo", "db-vm"], "stdout_file": "virsh_dominfo_db-vm.txt" },
    { "match": ["virsh", "-c", "qemu:///system", "dumpxml", "db-vm"], "stdout_file": "virsh_dumpxml_db-vm.txt" },
    { "match": ["virsh", "-c", "qemu:///system", "start"], "stdout": "Domain started\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "shutdown"], "stdout": "Domain is being shutdown\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "destroy"], "stdout": "Domain destroyed\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "reboot"], "stdout": "Domain is being rebooted\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "suspend"], "stdout": "Domain suspended\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "resume"], "stdout": "Domain resumed\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "autostart"], "stdout": "Domain marked as autostarted\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "undefine"], "stdout": "Domain undefined\n", "exit_code": 0, "simulated": true },
    { "match": ["virsh", "-c", "qemu:///system", "define"], "stdout": "Domain defined\n", "exit_code": 0, "simulated": true },
    { "match": ["virt-xml-validate"], "stdout": "Validates\n", "exit_code": 0, "simulated": true },
    { "match": ["qemu-img", "create"], "stdout": "Formatting, fmt=qcow2\n", "exit_code": 0, "simulated": true },

    { "match": ["ss", "-tulpnH"], "stdout_file": "ss.txt" },
    { "match": ["ss"], "stdout_file": "ss.txt" },

    { "match": ["hostname"], "stdout": "edge-01\n" },
    { "match": ["uname", "-sr"], "stdout": "Linux 6.8.0-45-generic\n" },

    { "match": ["sh", "-c", "command -v nginx"], "stdout": "/usr/sbin/nginx\n" },
    { "match": ["sh", "-c", "command -v haproxy"], "stdout": "/usr/sbin/haproxy\n" },
    { "match": ["sh", "-c", "command -v ufw"], "stdout": "/usr/sbin/ufw\n" },
    { "match": ["sh", "-c", "command -v iptables"], "stdout": "/usr/sbin/iptables\n" },
    { "match": ["sh", "-c", "command -v iptables-save"], "stdout": "/usr/sbin/iptables-save\n" },
    { "match": ["sh", "-c", "command -v ip6tables-save"], "stdout": "/usr/sbin/ip6tables-save\n" },
    { "match": ["sh", "-c", "command -v docker"], "stdout": "/usr/bin/docker\n" },
    { "match": ["sh", "-c", "command -v podman"], "stdout": "/usr/bin/podman\n" },
    { "match": ["sh", "-c", "command -v lxc"], "stdout": "/snap/bin/lxc\n" },
    { "match": ["sh", "-c", "command -v ss"], "stdout": "/usr/bin/ss\n" },
    { "match": ["sh", "-c", "command -v systemctl"], "stdout": "/usr/bin/systemctl\n" },
    { "match": ["sh", "-c", "command -v nft"], "exit_code": 1 },
    { "match": ["sh", "-c", "command -v fail2ban-client"], "exit_code": 1 }
  ]
}
