# Local overrides
.env

# Mobile app (mobile/, Kotlin Multiplatform) — the Gradle wrapper IS
# committed on purpose (a fresh clone builds without a preinstalled Gradle);
# build output, Kotlin/Native caches and machine paths are not.
/mobile/.gradle/
/mobile/.kotlin/
/mobile/**/build/
/mobile/local.properties
/mobile/scripts/env.sh
/mobile/iosApp/**/xcuserdata/

# Personal/promotional writing — not project documentation, not tracked.
/articles/

# NOTE: internal/webui/dist is intentionally committed — it is embedded into the
# binary, so `go build ./cmd/nkt` must work on a fresh clone without npm.

# Сайт (VitePress) — сборка и кэш
/site/.vitepress/dist/
/site/.vitepress/cache/

# Кэш Python скриптов скриншотов
__pycache__/
