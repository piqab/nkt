# Runtime state
/data/

# Node
node_modules/

# Build output
/nkt
/nkt.exe
/dist/
dist/*.map
web/tsconfig.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Local overrides
.env

# Android — build output and machine-specific paths. The Gradle wrapper
# (android/gradlew, android/gradle/wrapper/) IS committed on purpose: it is
# what lets a fresh clone build without a preinstalled Gradle.
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/scripts/env.sh

# Personal/promotional writing — not project documentation, not tracked.
/articles/

# NOTE: internal/webui/dist is intentionally committed — it is embedded into the
# binary, so `go build ./cmd/nkt` must work on a fresh clone without npm.
