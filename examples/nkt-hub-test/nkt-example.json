{
  "key": "nkthub",
  "link": "https://github.com/piqab/nkt/blob/main/deploy/docker-compose.hub.release.yml",
  "project": "nkt-hub-test",
  "readme": "https://github.com/piqab/nkt/tree/main/examples/nkt-hub-test",
  "site": {
    "service": "hub",
    "port": 8077
  },
  "own": true,
  "images": {
    "hub": "ghcr.io/piqab/nkt-hub:{hubversion}"
  },
  "ports": {
    "hub": [
      "127.0.0.1:18443:8077",
      "127.0.0.1:18446:8446"
    ]
  },
  "envKeys": {
    "hub": [
      "NKT_BOOTSTRAP_ADMIN_PASSWORD"
    ]
  },
  "env": [
    [
      "NKT_BOOTSTRAP_ADMIN_PASSWORD",
      "generate:password"
    ]
  ],
  "order": 140
}
